{
  "$schema": "https://raw.githubusercontent.com/Microsoft/azure-pipelines-task-lib/master/tasks.schema.json",
  "id": "d0f16a13-2e67-46b5-a4b4-72f5c2ddfa4c",
  "name": "Appknox",
  "friendlyName": "Appknox",
  "description": "Appknox",
  "helpMarkDown": "[Learn more about this task](https://marketplace.visualstudio.com/items?itemName=appknox.appknox)",
  "category": "Build",
  "author": "Appknox",
  "version": {
    "Major": 2,
    "Minor": 0,
    "Patch": 19
  },
  "instanceNameFormat": "Appknox $(filePath)",
  "showEnvironmentVariables": false,
  "minimumAgentVersion": "2.182.1",
  "inputs": [
    {
      "name": "filePath",
      "type": "string",
      "label": "File Path",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "Path to binary file"
    },
    {
      "name": "accessToken",
      "type": "string",
      "label": "Access Token",
      "defaultValue": "",
      "required": true,
      "helpMarkDown": "Appknox API access token"
    },
    {
      "name": "thresholdType",
      "type": "pickList",
      "label": "Threshold Type",
      "defaultValue": "risk",
      "options": {
        "risk": "Risk Threshold",
        "healthScore": "Health Score Threshold"
      },
      "required": true,
      "helpMarkDown": "Choose whether the build should fail based on a Risk Threshold or a Health Score Threshold."
    },
    {
      "name": "riskThreshold",
      "type": "pickList",
      "label": "Risk Threshold",
      "defaultValue": "low",
      "options": {
        "low": "Low",
        "medium": "Medium",
        "high": "High",
        "critical": "Critical"
      },
      "required": true,
      "visibleRule": "thresholdType = risk",
      "helpMarkDown": "Risk level for which build should fail."
    },
    {
      "name": "healthScoreThreshold",
      "type": "string",
      "label": "Health Score Threshold",
      "required": true,
      "defaultValue": "",
      "visibleRule": "thresholdType = healthScore",
      "helpMarkDown": "Health score threshold (0-100) to pass the command."
    },
    {
      "name": "host",
      "type": "string",
      "label": "Host URL",
      "required": false,
      "defaultValue": "",
      "helpMarkDown": "Optional. Specify the host URL e.g., https://api.appknox.com/. Leave blank to use the default."
    },
    {
      "name": "triggerKnoxiq",
      "type": "boolean",
      "label": "Trigger KnoxIQ",
      "defaultValue": "false",
      "required": false,
      "helpMarkDown": "Optional. If enabled, KnoxIQ triage is requested during upload and its results are reflected by the CI check."
    }
  ],
  "execution": {
    "Node10": {
      "target": "index.js"
    }
  }
}
